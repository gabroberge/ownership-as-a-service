---
const headline = [
	{ value: '100%', label: 'Ownership coverage' },
	{ value: '0', label: 'Unassigned items' },
	{ value: '−94%', label: 'Dropped responsibilities' },
	{ value: '1.2s', label: 'Median time to owner resolution' },
];

const telemetry = [
	['Responsibilities inferred', '147'],
	['Explicit assignments', '3'],
	['Unique inferred owners', '1'],
	['Bus factor', '1'],
	['Process maturity', 'HIGH'],
];
---

<section class="border-b border-console-line bg-console text-console-text">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="reveal max-w-2xl">
			<p class="eyebrow text-signal">Outcomes</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
				The dashboard is green.
			</h2>
			<p class="mt-4 text-[16px] leading-relaxed text-console-dim">
				Representative customer telemetry, twelve months post-deployment.
			</p>
		</div>

		<dl class="reveal mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
			{
				headline.map((m) => (
					<div class="border-t border-console-line pt-5">
						<dd class="font-mono text-4xl font-medium tracking-tight text-signal tabular-nums sm:text-5xl">
							{m.value}
						</dd>
						<dt class="mt-3 text-[14px] text-console-dim">{m.label}</dt>
					</div>
				))
			}
		</dl>

		<div class="reveal mt-14 rounded-md border border-console-line bg-console-soft px-5 py-4">
			<dl class="flex flex-wrap items-baseline gap-x-10 gap-y-3 font-mono text-xs">
				{
					telemetry.map(([label, value]) => (
						<div class="flex items-baseline gap-3">
							<dt class="tracking-[0.14em] text-console-dim uppercase">{label}</dt>
							<dd class="text-console-text tabular-nums">{value}</dd>
						</div>
					))
				}
			</dl>
		</div>
		<p class="reveal mt-4 font-mono text-[11px] text-console-dim">
			All figures within expected convergence parameters.
		</p>
	</div>
</section>
