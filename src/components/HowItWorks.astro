---
const steps = [
	{
		n: '01',
		name: 'Observe',
		body: 'OaaS connects to the tools where work already happens and watches how it actually moves: who notices, who follows up, who retains context, who asks the question no one else wants to ask. No surveys. No workshops. No self-reporting.',
	},
	{
		n: '02',
		name: 'Infer',
		body: 'Behavioral signals resolve into ownership probabilities. Formal assignment is one input among many — and, statistically, one of the weakest predictors of who will actually act.',
	},
	{
		n: '03',
		name: 'Route',
		body: 'When explicit ownership is absent, ambiguous, or shared, responsibility routes automatically to the person most likely to prevent failure. Before failure happens. No discussion required.',
	},
];
---

<section class="border-b border-line bg-surface">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-28">
		<div class="reveal max-w-2xl">
			<p class="eyebrow">How it works</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
				Ownership shouldn't need to be assigned. It should emerge.
			</h2>
		</div>

		<ol class="reveal mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
			{
				steps.map((step) => (
					<li class="relative border-t-2 border-accent pt-6">
						<span class="font-mono text-xs tracking-[0.16em] text-muted">{step.n}</span>
						<h3 class="mt-2 text-xl font-semibold tracking-tight">{step.name}</h3>
						<p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{step.body}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
