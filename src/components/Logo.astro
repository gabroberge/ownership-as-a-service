---
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
	<svg
		width="26"
		height="26"
		viewBox="0 0 64 64"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<rect width="64" height="64" rx="14" class="fill-ink"></rect>
		<g class="stroke-[#83878e]" stroke-width="3" stroke-linecap="round" fill="none">
			<path d="M14 16 Q30 16 40 29"></path>
			<path d="M12 32 L36 32"></path>
			<path d="M14 48 Q30 48 40 35"></path>
		</g>
		<circle cx="45" cy="32" r="7" class="fill-signal"></circle>
	</svg>
	<span class="text-[17px] font-semibold tracking-tight">
		OaaS<span class="align-super text-[9px] font-normal text-muted">™</span>
	</span>
</span>
